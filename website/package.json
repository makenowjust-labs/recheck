{
  "private": true,
  "name": "website",
  "version": "0.0.0",
  "scripts": {
    "doc": "docusaurus build",
    "format": "prettier -w '*.{js,json,ts}' '{src,e2e}/**/*.{css,md,ts}' '{blog,docs}/**/*.{md,mdx}'",
    "lint": "prettier --check '*.{js,json,ts}' '{src,e2e}/**/*.{css,md,ts}' '{blog,docs}/**/*.{md,mdx}'",
    "start": "docusaurus start",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@algolia/client-search": "^5.0.0",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "^3.9.2",
    "@docusaurus/plugin-ideal-image": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "lz-string": "1.5.0",
    "prism-react-renderer": "2.4.1",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-loadable": "^5.5.0",
    "recheck": "workspace:*",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
