{
  "extends": [
    "config:base"
  ],
  "automerge": true,
  "regexManagers": [
    {
      "fileMatch": [
        "^.scalafmt.conf"
      ],
      "matchStrings": [
        "version=(?<currentValue>.*)\n"
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "org.scalameta:scalafmt-core_2.13",
      "depTypeTemplate": "scalafmt"
    },
    {
      "fileMatch": [
        "\\.sbt$"
      ],
      "matchStrings": [
        "scalafixDependencies\\s*\\+=\\s*\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>[^\"]*)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\""
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_2.13",
      "depTypeTemplate": "scalafix plugin"
    },
    {
      "fileMatch": [
        "\\.sbt$"
      ],
      "matchStrings": [
        "addCompilerPlugin\\s*\\(\\s*\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>[^\"]*)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\"\\s*\\)"
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_2.13",
      "depTypeTemplate": "compiler plugin"
    },
    {
      "fileMatch": [
        "\\.sbt$"
      ],
      "matchStrings": [
        "\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>circe-scalajs)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\""
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_sjs1_3",
      "depTypeTemplate": "Scala.js library"
    },
    {
      "fileMatch": [
        "\\.sbt$"
      ],
      "matchStrings": [
        "\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>scalajs-java-securerandom)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\""
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_sjs1_2.13",
      "depTypeTemplate": "Scala.js library"
    }
  ]
}
