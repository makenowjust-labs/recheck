{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "An update of a runtime that recheck checks against needs the checked versions in the tests and the docs updated too.",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "java",
        "node",
        "python",
        "ruby",
        "dotnet",
        "perl"
      ],
      "automerge": false
    },
    {
      "description": "mise installs Perl from the stable builds of skaji/relocatable-perl (e.g. 5.44.0.0), not from the tags of Perl itself, which include development releases.",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "perl"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "skaji/relocatable-perl",
      "extractVersion": "^(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)$",
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.scalafmt.conf/"
      ],
      "matchStrings": [
        "version=(?<currentValue>.*)\n"
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "org.scalameta:scalafmt-core_2.13",
      "depTypeTemplate": "scalafmt"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.sbt$/"
      ],
      "matchStrings": [
        "scalafixDependencies\\s*\\+=\\s*\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>[^\"]*)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\""
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_2.13",
      "depTypeTemplate": "scalafix plugin"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.sbt$/"
      ],
      "matchStrings": [
        "addCompilerPlugin\\s*\\(\\s*\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>[^\"]*)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\"\\s*\\)"
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_2.13",
      "depTypeTemplate": "compiler plugin"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.sbt$/"
      ],
      "matchStrings": [
        "\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>circe-scalajs)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\""
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_sjs1_3",
      "depTypeTemplate": "Scala.js library"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.sbt$/"
      ],
      "matchStrings": [
        "\"(?<orgName>[^\"]*)\"\\s*%%\\s*\"(?<artifactName>scalajs-java-securerandom)\"\\s*%\\s*\"(?<currentValue>[^\"]*)\""
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "{{{ orgName }}}:{{{ artifactName }}}_sjs1_2.13",
      "depTypeTemplate": "Scala.js library"
    }
  ]
}
