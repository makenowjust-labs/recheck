{
  "name": "eslint-plugin-redos",
  "version": "0.0.0",
  "description": "ESLint plugin for catching ReDoS vulnerability",
  "license": "MIT",
  "author": {
    "name": "TSUYUSATO Kitsune",
    "email": "make.just.on@gmail.com"
  },
  "homepage": "https://makenowjust-labs.github.io/recheck/",
  "repository": {
    "type": "git",
    "url": "https://github.com/makenowjust-labs/recheck.git"
  },
  "main": "lib/main.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./lib/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "build": "node ./scripts/build.mts",
    "clean": "rimraf lib",
    "format": "prettier -w '*.{json,md}' '{scripts,src}/**/*.{ts,mts}'",
    "lint": "prettier --check '*.{json,md}' '{scripts,src}/**/*.{ts,mts}'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "recheck": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">= 3"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.9",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "redos",
    "regexp",
    "security"
  ]
}
