{
  "name": "recheck",
  "version": "0.0.0",
  "description": "The trustworthy ReDoS checker",
  "license": "MIT",
  "author": {
    "name": "TSUYUSATO Kitsune",
    "email": "make.just.on@gmail.com"
  },
  "homepage": "https://makenowjust-labs.github.io/recheck/",
  "repository": {
    "type": "git",
    "url": "https://github.com/makenowjust-labs/recheck.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "browser": "lib/browser.js",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./index.d.mts",
          "default": "./lib/browser.mjs"
        },
        "default": {
          "types": "./index.d.ts",
          "default": "./lib/browser.js"
        }
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./lib/browser": {
      "import": {
        "types": "./index.d.mts",
        "default": "./lib/browser.mjs"
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./lib/browser.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.d.mts",
    "index.d.ts",
    "index.mjs",
    "lib"
  ],
  "scripts": {
    "build": "node -r esbuild-register ./scripts/build.ts",
    "clean": "rimraf lib",
    "format": "prettier -w '*.{js,json,md,mjs}' '{scripts,src}/**/*.{js,ts}' index.d.ts index.d.mts",
    "lint": "prettier --check '*.{js,json,md,mjs}' '{scripts,src}/**/*.{js,ts}' index.d.ts index.d.mts",
    "test": "SYNCKIT_TS_RUNNER=esbuild-register jest",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c jest.e2e.config.js --forceExit",
    "typecheck": "tsc --noEmit -p ."
  },
  "sideEffects": false,
  "types": "index.d.ts",
  "dependencies": {
    "synckit": "0.12.3"
  },
  "optionalDependencies": {
    "recheck-jar": "workspace:*",
    "recheck-linux-arm64": "workspace:*",
    "recheck-linux-x64": "workspace:*",
    "recheck-macos-x64": "workspace:*",
    "recheck-macos-arm64": "workspace:*",
    "recheck-windows-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "esbuild-jest": "0.5.0",
    "esbuild-register": "3.6.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "redos",
    "regexp",
    "security",
    "vulnerability"
  ]
}
