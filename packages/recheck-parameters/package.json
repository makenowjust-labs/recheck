{
  "private": true,
  "name": "recheck-parameters",
  "version": "0.0.0",
  "description": "The recheck parameters read from their schema, for the builds of the other packages",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./parameters.d.ts": "./lib/parameters.d.ts"
  },
  "scripts": {
    "build": "node ./scripts/build.mts",
    "clean": "rimraf lib",
    "format": "prettier -w '*.{js,json,ts}' 'scripts/**/*.mts'",
    "lint": "prettier --check '*.{js,json,ts}' 'scripts/**/*.mts'",
    "prepare": "node ./scripts/build.mts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
